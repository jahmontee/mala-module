@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
<urn:beebo-hector-lab:mala-preview> a lv2:Plugin ; doap:name "Mala Preview" ;
doap:license <https://opensource.org/license/mit> ;
lv2:extensionData <http://lv2plug.in/ns/ext/state#interface> ;
lv2:optionalFeature <http://lv2plug.in/ns/ext/urid#map> ; lv2:port [ a lv2:ControlPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "time" ; lv2:name "Time" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0.25 ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 1 ; lv2:symbol "size" ; lv2:name "Size" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0.6 ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 2 ; lv2:symbol "shape" ; lv2:name "Shape" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0.6 ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 3 ; lv2:symbol "pitch" ; lv2:name "Pitch (semitones)" ; lv2:minimum -24 ; lv2:maximum 24 ; lv2:default 0 ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "density" ; lv2:name "Density" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0.73 ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "time_amount" ; lv2:name "Time attenurandomizer" ; lv2:minimum -1 ; lv2:maximum 1 ; lv2:default 0 ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "size_amount" ; lv2:name "Size attenurandomizer" ; lv2:minimum -1 ; lv2:maximum 1 ; lv2:default 0 ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "shape_amount" ; lv2:name "Shape attenurandomizer" ; lv2:minimum -1 ; lv2:maximum 1 ; lv2:default 0 ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "pitch_amount" ; lv2:name "Pitch attenurandomizer" ; lv2:minimum -1 ; lv2:maximum 1 ; lv2:default 0 ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 9 ; lv2:symbol "feedback" ; lv2:name "Feedback" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0.2 ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 10 ; lv2:symbol "mix" ; lv2:name "Dry / wet" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0.85 ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 11 ; lv2:symbol "reverb" ; lv2:name "Reverb" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0.15 ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 12 ; lv2:symbol "freeze" ; lv2:name "Freeze latch" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 13 ; lv2:symbol "seed" ; lv2:name "Seed (off, held, latched)" ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:default 2 ; lv2:portProperty lv2:integer ],
[ a lv2:AudioPort, lv2:InputPort ; lv2:index 14 ; lv2:symbol "left_in" ; lv2:name "IN L" ],
[ a lv2:AudioPort, lv2:InputPort ; lv2:index 15 ; lv2:symbol "right_in" ; lv2:name "IN R" ],
[ a lv2:AudioPort, lv2:OutputPort ; lv2:index 16 ; lv2:symbol "left_out" ; lv2:name "OUT L" ],
[ a lv2:AudioPort, lv2:OutputPort ; lv2:index 17 ; lv2:symbol "right_out" ; lv2:name "OUT R" ],
[ a lv2:CVPort, lv2:InputPort ; lv2:index 18 ; lv2:symbol "time_cv" ; lv2:name "Time CV (V)" ; lv2:minimum -8 ; lv2:maximum 8 ; lv2:default 0 ],
[ a lv2:CVPort, lv2:InputPort ; lv2:index 19 ; lv2:symbol "size_cv" ; lv2:name "Size CV (V)" ; lv2:minimum -8 ; lv2:maximum 8 ; lv2:default 0 ],
[ a lv2:CVPort, lv2:InputPort ; lv2:index 20 ; lv2:symbol "shape_cv" ; lv2:name "Shape CV (V)" ; lv2:minimum -8 ; lv2:maximum 8 ; lv2:default 0 ],
[ a lv2:CVPort, lv2:InputPort ; lv2:index 21 ; lv2:symbol "pitch_cv" ; lv2:name "Pitch CV (V)" ; lv2:minimum -8 ; lv2:maximum 8 ; lv2:default 0 ],
[ a lv2:CVPort, lv2:InputPort ; lv2:index 22 ; lv2:symbol "density_cv" ; lv2:name "Density CV (V)" ; lv2:minimum -5 ; lv2:maximum 5 ; lv2:default 0 ],
[ a lv2:CVPort, lv2:InputPort ; lv2:index 23 ; lv2:symbol "assign_cv" ; lv2:name "Assignable CV (V)" ; lv2:minimum -5 ; lv2:maximum 5 ; lv2:default 0 ],
[ a lv2:CVPort, lv2:InputPort ; lv2:index 24 ; lv2:symbol "seed_gate" ; lv2:name "SEED gate (logic)" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ],
[ a lv2:CVPort, lv2:InputPort ; lv2:index 25 ; lv2:symbol "freeze_gate" ; lv2:name "FREEZE gate (logic)" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 26 ; lv2:symbol "connections" ; lv2:name "Derived CV/gate connections" ; lv2:minimum 0 ; lv2:maximum 255 ; lv2:default 0 ; lv2:portProperty lv2:integer, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 27 ; lv2:symbol "assign_destination" ; lv2:name "Assignable CV destination" ; lv2:minimum 0 ; lv2:maximum 3 ; lv2:default 0 ; lv2:portProperty lv2:integer ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 28 ; lv2:symbol "feedback_cv_amount" ; lv2:name "Feedback CV amount" ; lv2:minimum 0 ; lv2:maximum 255 ; lv2:default 255 ; lv2:portProperty lv2:integer ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 29 ; lv2:symbol "mix_cv_amount" ; lv2:name "Dry/wet CV amount" ; lv2:minimum 0 ; lv2:maximum 255 ; lv2:default 0 ; lv2:portProperty lv2:integer ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 30 ; lv2:symbol "reverb_cv_amount" ; lv2:name "Reverb CV amount" ; lv2:minimum 0 ; lv2:maximum 255 ; lv2:default 128 ; lv2:portProperty lv2:integer ],
[ a lv2:ControlPort, lv2:OutputPort ; lv2:index 31 ; lv2:symbol "active_freeze" ; lv2:name "Freeze active" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 32 ; lv2:symbol "quality" ; lv2:name "Recording quality" ; lv2:minimum 0 ; lv2:maximum 3 ; lv2:default 0 ; lv2:scalePoint [ rdfs:label "Bright digital" ; rdf:value 0 ], [ rdfs:label "Cold digital" ; rdf:value 1 ], [ rdfs:label "Sunny tape" ; rdf:value 2 ], [ rdfs:label "Scorched cassette" ; rdf:value 3 ] ; lv2:portProperty lv2:integer, lv2:enumeration ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 33 ; lv2:symbol "mono" ; lv2:name "Mono recording" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled ],
[ a lv2:ControlPort, lv2:OutputPort ; lv2:index 34 ; lv2:symbol "active_quality" ; lv2:name "Active recording quality" ; lv2:minimum 0 ; lv2:maximum 3 ; lv2:portProperty lv2:integer, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:OutputPort ; lv2:index 35 ; lv2:symbol "active_mono" ; lv2:name "Active mono recording" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:OutputPort ; lv2:index 36 ; lv2:symbol "buffer_seconds" ; lv2:name "Recording buffer (seconds)" ; lv2:minimum 0 ; lv2:maximum 32 ; lv2:portProperty pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:OutputPort ; lv2:index 37 ; lv2:symbol "mode_transition" ; lv2:name "Quality transition" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:OutputPort ; lv2:index 38 ; lv2:symbol "latency" ; lv2:name "Adapter latency (host frames)" ; lv2:minimum 0 ; lv2:maximum 204 ; lv2:designation lv2:latency ; lv2:portProperty lv2:integer, pprops:notOnGUI, lv2:reportsLatency ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 39 ; lv2:symbol "input_stage" ; lv2:name "Beads input stage" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 40 ; lv2:symbol "audio_connections" ; lv2:name "Derived audio connections (L=1, R=2)" ; lv2:minimum 0 ; lv2:maximum 3 ; lv2:default 3 ; lv2:portProperty lv2:integer, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 41 ; lv2:symbol "input_gain" ; lv2:name "Input gain (0=automatic, 1–255=manual)" ; lv2:minimum 0 ; lv2:maximum 255 ; lv2:default 0 ; lv2:portProperty lv2:integer ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 42 ; lv2:symbol "gain_relearn" ; lv2:name "Gain relearn request counter" ; lv2:minimum 0 ; lv2:maximum 16777215 ; lv2:default 0 ; lv2:portProperty lv2:integer, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:OutputPort ; lv2:index 43 ; lv2:symbol "gain_adjusting" ; lv2:name "Automatic gain learning" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:OutputPort ; lv2:index 44 ; lv2:symbol "input_vu" ; lv2:name "Original input VU meter" ; lv2:minimum 0 ; lv2:maximum 255 ; lv2:portProperty lv2:integer, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 45 ; lv2:symbol "synth_enable" ; lv2:name "Beads automatic wavetable synthesis" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:OutputPort ; lv2:index 46 ; lv2:symbol "active_synth" ; lv2:name "Wavetable synthesis active" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:OutputPort ; lv2:index 47 ; lv2:symbol "synth_wait_seconds" ; lv2:name "Silent no-input wait (seconds)" ; lv2:minimum 0 ; lv2:maximum 10 ; lv2:portProperty pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 48 ; lv2:symbol "buffer_autosave" ; lv2:name "Remember frozen buffer" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled ],
[ a lv2:ControlPort, lv2:OutputPort ; lv2:index 49 ; lv2:symbol "buffer_state" ; lv2:name "Frozen buffer status" ; lv2:minimum 0 ; lv2:maximum 4 ; lv2:portProperty lv2:integer, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:OutputPort ; lv2:index 50 ; lv2:symbol "buffer_wait_seconds" ; lv2:name "Continuous Freeze wait (seconds)" ; lv2:minimum 0 ; lv2:maximum 10 ; lv2:portProperty pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:OutputPort ; lv2:index 51 ; lv2:symbol "buffer_epoch" ; lv2:name "Saved buffer revision" ; lv2:minimum 0 ; lv2:maximum 16777215 ; lv2:portProperty lv2:integer, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 52 ; lv2:symbol "freeze_release" ; lv2:name "Restored Freeze release counter" ; lv2:minimum 0 ; lv2:maximum 16777215 ; lv2:default 0 ; lv2:portProperty lv2:integer, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 53 ; lv2:symbol "output_normalization" ; lv2:name "Beads output normalization" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 54 ; lv2:symbol "output_connections" ; lv2:name "Audio output connections" ; lv2:minimum 0 ; lv2:maximum 3 ; lv2:default 3 ; lv2:portProperty lv2:integer, pprops:notOnGUI ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 55 ; lv2:symbol "grain_triggers" ; lv2:name "Right output grain triggers" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 56 ; lv2:symbol "panel_response" ; lv2:name "Beads knob response" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled ],
[ a lv2:ControlPort, lv2:InputPort ; lv2:index 57 ; lv2:symbol "cv_input_units" ; lv2:name "CV input units" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:scalePoint [ rdfs:label "Legacy virtual volts" ; rdf:value 0 ], [ rdfs:label "Hector / Poly units (x5)" ; rdf:value 1 ] ; lv2:portProperty lv2:integer, lv2:enumeration ] .
